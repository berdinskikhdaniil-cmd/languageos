# Copy to .env and adjust. .env is gitignored.

# --- Application database ---------------------------------------------------
# Must match the docker-compose service below when using the local container.
# Use 127.0.0.1, not "localhost": localhost resolves to both ::1 and 127.0.0.1,
# and when the database is down the IPv6 attempt blackholes for ~30s instead of
# refusing immediately. Pinning IPv4 makes an outage fail fast and cleanly.
DATABASE_URL="postgresql://language_os:language_os@127.0.0.1:5442/language_os"

# --- Local Postgres container (docker-compose.yml) --------------------------
POSTGRES_USER="language_os"
POSTGRES_PASSWORD="language_os"
POSTGRES_DB="language_os"
POSTGRES_PORT="5442"

# --- Time ------------------------------------------------------------------
# Day and week boundaries are computed in the user's timezone. Until we read a
# real timezone from Telegram or user settings, new users get this one.
DEFAULT_TIMEZONE="Europe/Moscow"

# --- Telegram authentication ------------------------------------------------
# From @BotFather. Server-only: it verifies the initData signature and must
# never be exposed to a browser, so it must NOT have a NEXT_PUBLIC_ prefix.
TELEGRAM_BOT_TOKEN=""

# How long a Telegram launch payload stays acceptable, in seconds.
# It is only used once at startup, so this can be short. Default 3600.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="3600"

# Lifetime of one of our own sessions and of its cookie, in seconds.
# Default 2592000 (30 days).
AUTH_SESSION_TTL_SECONDS="2592000"

# Run requests without a session as the local development user.
# Requires an explicit "true" AND a non-production NODE_ENV — setting this on a
# production build has no effect. Never a fallback for a failed Telegram sign-in.
ALLOW_DEV_AUTH="true"
