# Copy to .env and adjust. .env is gitignored.

# --- Application database ---------------------------------------------------
# Must match the docker-compose service below when using the local container.
# Use 127.0.0.1, not "localhost": localhost resolves to both ::1 and 127.0.0.1,
# and when the database is down the IPv6 attempt blackholes for ~30s instead of
# refusing immediately. Pinning IPv4 makes an outage fail fast and cleanly.
DATABASE_URL="postgresql://language_os:language_os@127.0.0.1:5442/language_os"

# --- Local Postgres container (docker-compose.yml) --------------------------
POSTGRES_USER="language_os"
POSTGRES_PASSWORD="language_os"
POSTGRES_DB="language_os"
POSTGRES_PORT="5442"

# --- Time ------------------------------------------------------------------
# Day and week boundaries are computed in each learner's own timezone, which
# they confirm during onboarding from their device. This one is only used by
# the development seed (`npm run db:seed`).
DEFAULT_TIMEZONE="Europe/Moscow"

# --- Telegram authentication ------------------------------------------------
# From @BotFather. Server-only: it verifies the initData signature and must
# never be exposed to a browser, so it must NOT have a NEXT_PUBLIC_ prefix.
TELEGRAM_BOT_TOKEN=""

# How long a Telegram launch payload stays acceptable, in seconds.
# It is only used once at startup, so this can be short. Default 3600.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="3600"

# Lifetime of one of our own sessions and of its cookie, in seconds.
# Default 2592000 (30 days).
AUTH_SESSION_TTL_SECONDS="2592000"

# --- Telegram bot ------------------------------------------------------------
# The Mini App's own URL, used for the "Open Language OS" button, the bot's menu
# button and, with /api/telegram/webhook appended, the webhook endpoint. It must
# be https in production; http is only tolerated against localhost, and a
# localhost URL is never sent to Telegram, which could not open it anyway.
TELEGRAM_WEBAPP_URL=""

# Echoed back by Telegram in the X-Telegram-Bot-Api-Secret-Token header on every
# webhook delivery, and the only thing guarding that public endpoint. Generate a
# random value (`openssl rand -hex 32`). Server-only: no NEXT_PUBLIC_ prefix.
TELEGRAM_WEBHOOK_SECRET=""

# --- AI (OpenRouter) --------------------------------------------------------
# Writing review, and the review half of Speaking, are off until both of these
# are set. Server-only: neither may ever carry a NEXT_PUBLIC_ prefix, and the
# key is a spending credential — treat it like the bot token.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Which model reviews writing, as an OpenRouter model slug. There is no default:
# a silent fallback would spend your credit on a model you did not choose. It
# must support JSON-schema structured output — the request asks for the schema
# to be honoured, and routing skips providers that cannot.
OPENROUTER_MODEL=""

# How long to wait for a review before giving up, in milliseconds. Default 45000.
# Keep it under your host's function timeout.
OPENROUTER_TIMEOUT_MS="45000"

# --- Speaking (speech to text) ----------------------------------------------
# Which model turns a recording into text, as an OpenRouter model slug. Speaking
# is off without it, and Writing is unaffected either way. No default, for the
# same reason as above. See the current roster at
# https://openrouter.ai/api/v1/models?output_modalities=transcription
OPENROUTER_STT_MODEL="openai/whisper-large-v3"

# How long to wait for a transcription, in milliseconds. Default 50000.
# OpenRouter's own upstreams give up at 60 seconds, so waiting longer than that
# only burns your function's time limit.
OPENROUTER_STT_TIMEOUT_MS="50000"

# How many pieces of writing one learner may have reviewed per day. Default 20.
# Retrying a failed review does not count again.
WRITING_DAILY_REVIEW_LIMIT="20"

# Run requests without a session as the local development user.
# Requires an explicit "true" AND a non-production NODE_ENV — setting this on a
# production build has no effect. Never a fallback for a failed Telegram sign-in.
ALLOW_DEV_AUTH="true"
