# Copy to .env and adjust. .env is gitignored.

# --- Application database ---------------------------------------------------
# Must match the docker-compose service below when using the local container.
# Use 127.0.0.1, not "localhost": localhost resolves to both ::1 and 127.0.0.1,
# and when the database is down the IPv6 attempt blackholes for ~30s instead of
# refusing immediately. Pinning IPv4 makes an outage fail fast and cleanly.
DATABASE_URL="postgresql://language_os:language_os@127.0.0.1:5442/language_os"

# --- Local Postgres container (docker-compose.yml) --------------------------
POSTGRES_USER="language_os"
POSTGRES_PASSWORD="language_os"
POSTGRES_DB="language_os"
POSTGRES_PORT="5442"

# --- Time ------------------------------------------------------------------
# Day and week boundaries are computed in the user's timezone. Until we read a
# real timezone from Telegram or user settings, new users get this one.
DEFAULT_TIMEZONE="Europe/Moscow"
